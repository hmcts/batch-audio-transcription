# ── Core ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=local
DATABASE_CONNECTION_STRING=postgresql://dev:devpass@localhost:5432/transcription_svc

# ── Azure Speech ──────────────────────────────────────────────────────────────
AZURE_SPEECH_KEY=your-azure-speech-key-here
AZURE_SPEECH_ENDPOINT=https://your-region.cognitiveservices.azure.com

# ── Azure Storage ─────────────────────────────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
AZURE_STORAGE_CONTAINER_NAME=your-container
# Local dev only: set this to avoid mounting ~/.azure into Docker.
# Leave unset in deployed environments — Managed Identity is used instead.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# ── Azure AD / JWT authentication ────────────────────────────────────────────
# Required in deployed environments (dev/stg/prod). Unset = JWT verification is
# still attempted but will fail silently for all requests.
AZURE_AD_CLIENT_ID=your-app-registration-client-id
AZURE_AD_TENANT_ID=your-tenant-id
# Set to false only in local dev without Easy Auth (disables JWT verification).
# JWT_ENABLE_VERIFICATION=false
# AUTH_APPROLES: optional JSON override for Azure AD app role names.
# Leave unset to use the defaults: Judge, LegalTextManager, SystemAdministrator, Normal.
# Override example: AUTH_APPROLES='{"Judge":"Judge","LegalTextManager":"LegalTextManager","SystemAdministrator":"SystemAdministrator","Normal":"Normal"}'

# ── Service ───────────────────────────────────────────────────────────────────
LOCAL_API_KEY=local-dev-key-change-me
BATCH_POLL_INTERVAL_SECONDS=30
BATCH_TRANSCRIPTION_THRESHOLD_HOURS=2.0

# Non-local environments: used by migration 004 to seed/rotate the frontend-service Caller.
# FRONTEND_SERVICE_API_KEY=change-me
# ── Webhook ───────────────────────────────────────────────────────────────────
WEBHOOK_TIMEOUT_SECONDS=30.0
WEBHOOK_MAX_RETRIES=3

# ── Optional ──────────────────────────────────────────────────────────────────
# LOW_CONFIDENCE_THRESHOLD=0.7
# SENTRY_DSN=https://your-sentry-dsn
